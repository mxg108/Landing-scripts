# OS
.DS_Store
Thumbs.db

# Local deploy log written by push.sh
.push-log

# Staged build dirs created by push.sh for multi-team overlays
.build/

# Dialpad-call-details cache (one JSON per call_id) used by migration
# scripts to avoid re-hitting the API on re-runs.
.dialpad_cache/

# Secrets
.env
*.env

# Google Apps Script project IDs
.clasp.json
appsscript.json

# Sensitive Looker references (dashboard structure, field names, IDs)
mass-notifications/src/lookerclient/LookML_Dashboard_Reference.yaml
mass-notifications/src/lookerclient/Looker_API_Reference_and_Apps_Script_Plan.md

# AI assistant context / spec docs (kept locally, not shared via git)
CLAUDE.md
**/CLAUDE.md

# Local-only onboarding walkthrough for new contributors. CONTRIBUTING.md is
# the shared/tracked policy doc; this file is the tutor-style companion that
# lives only on the lead's machine.
docs/git-for-the-recruit.md

# Raw Analyst_History sheet exports — qa.evaluations backfill seeds. Contain
# PII (agent/caller names, phones, Dialpad links); only derived, anonymized
# fixtures under tests/fixtures/ are committed.
database/analyst_history_*.csv
database/export_document_test_data.csv
database/onepager_*.html

# B0 staging outputs (backfill_seed_b0.py) — derived from the seed CSVs,
# same PII surface. Reports included: exclusion rows carry agent names.
database/backfill_staging/
# EOM CSV exports (export_eom_csvs.py) — agent names + scores, operator
# deliverables; never repo content.
database/eom_exports/

# Python bytecode
__pycache__/
*.pyc
