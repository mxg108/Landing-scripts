/**
 * Derive a human-readable name from an email local-part.
 * Examples:
 *  "maria@x.com"            -> "Maria"
 *  "maximiliano.perez@x"    -> "Maximiliano Perez"
 *  "april_kasky@x"          -> "April Kasky"
 *  "lucas-ridenour@x"       -> "Lucas Ridenour"
 *  "jane+ops@x"             -> "Jane"
 */
function deriveNameFromEmail_(email) {
  if (!email) return '';
  const raw = String(email).trim();
  const at = raw.indexOf('@');
  const local = (at > 0 ? raw.slice(0, at) : raw)
    .replace(/\+.*$/, '');                // strip +tag
  const words = local
    .replace(/[\._\-]+/g, ' ')            // dots/underscores/hyphens -> space
    .replace(/[^a-zA-ZÀ-ÖØ-öø-ÿ\s]/g, ' ')// remove other non-letters
    .trim()
    .split(/\s+/)
    .filter(Boolean);

  if (!words.length) return '';
  // Capitalize each token; keep single-letter tokens uppercase
  const caps = words.map(w => w.length === 1
    ? w.toUpperCase()
    : (w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
  );
  return caps.join(' ');
}


/**
 * Preview-only normalizer for tel: anchors.
 * - Fixes accidental self-closing <a .../> → <a ...></a>
 * - Normalizes href="tel:..." to digits/plus only (display text untouched)
 */
function normalizeTelLinks_(html) {
  if (!html) return '';
  let out = String(html);

  // Convert accidental <a .../> to proper open/close so HtmlService parser doesn't choke
  out = out.replace(/<a([^>]*?)\/>/gi, '<a$1></a>');

  // Normalize tel: URIs (remove spaces/parentheses/dashes, keep + and digits)
  out = out.replace(/href\s*=\s*(['"])\s*tel\s*:\s*([^'"]+)\1/gi, (m, q, num) => {
    const clean = String(num).replace(/[^\d+]/g, '');
    return `href="tel:${clean}"`;
  });

  return out;
}


/**
 * Make HTML safer for HtmlService preview (does NOT affect real send).
 * - Removes inline <script> (defense-in-depth: should not be present)
 * - Collapses/omits heavy <table> blocks (common in signatures)
 * - Removes dir="ltr" and other odd attrs that sometimes break parser
 * - Ensures we always return a non-empty string
 */
function makePreviewSafe_(html) {
  if (!html) return '';
  let out = String(html);

  // remove scripts entirely
  out = out.replace(/<script[\s\S]*?<\/script>/gi, '');

  // collapse big tables (signatures often use nested tables)
  // replace with a lightweight placeholder so operators know it's there
  //out = out.replace(/<table[\s\S]*?<\/table>/gi, '<div style="opacity:.8;font-style:italic;">[Signature or table content omitted in preview]</div>');

  // strip dir="..."; it sometimes causes parser issues in complex blocks
  out = out.replace(/\sdir="[^"]*"/gi, '');

  // optional: normalize stray <tbody> without a table (very rare)
  out = out.replace(/<\/?tbody>/gi, '');

  // fallback
  return out || '';
}


function summarizeAttachmentNames_(ids) {
  if (!ids || !ids.length) return { names: [], notes: [] };
  const names = [];
  const notes = [];
  ids.forEach(id => {
    try {
      const f = DriveApp.getFileById(id);
      const mime = f.getMimeType();
      const isGoogle = /^application\/vnd\.google\-apps\./.test(mime);
      names.push(f.getName() + (isGoogle ? ' (Google file → PDF at send)' : ''));
    } catch (e) {
      notes.push(`ATTACH_NOT_FOUND id=${id}`);
    }
  });
  return { names, notes };
}


function parseIdList_(raw) {
  if (!raw) return [];
  return String(raw)
    .split(/[,\s]+/)
    .map(s => s.trim())
    .filter(Boolean)
    .filter((v, i, a) => a.indexOf(v) === i); // dedupe
}

function getBlobsForIds_(ids, opts = {}) {
  // opts: { exportGoogleToPdf: true, maxBytes: 20*1024*1024 }
  const blobs = [];
  let total = 0;
  const maxBytes = (opts.maxBytes || 20 * 1024 * 1024);

  ids.forEach(id => {
    try {
      const f = DriveApp.getFileById(id);
      const mime = f.getMimeType();

      let blob;
      // If it's a Google Doc/Sheet/Slides and export requested:
      if (opts.exportGoogleToPdf && /^application\/vnd\.google\-apps\./.test(mime)) {
        // Requires Advanced Drive Service (Services → + → Drive API)
        // Export to PDF for consistency
        const exported = Drive.Files.export(id, 'application/pdf');
        blob = Utilities.newBlob(exported.getBytes(), 'application/pdf', f.getName() + '.pdf');
      } else {
        blob = f.getBlob(); // works for binary files (PDF/PNG/JPG/etc.)
      }

      total += blob.getBytes().length;
      blobs.push(blob);
    } catch (e) {
      throw new Error(`ATTACH_NOT_FOUND id=${id}`);
    }
  });

  if (total > maxBytes) {
    throw new Error(`ATTACH_TOO_LARGE total=${total}`);
  }
  return blobs;
}

function uniqueSheetName_(base) {
  const ss = SpreadsheetApp.getActive();
  let name = base, i = 1;
  while (ss.getSheetByName(name)) name = `${base}__${i++}`;
  return name;
}

function setConfigValue_(key, value) {
  const sh = SpreadsheetApp.getActive().getSheetByName(CONFIG_SHEET);
  const last = Math.max(2, sh.getLastRow());
  for (let r = 2; r <= last; r++) {
    if (String(sh.getRange(r,1).getValue()).trim() === key) {
      sh.getRange(r,2).setValue(value);
      return;
    }
  }
  sh.appendRow([key, value]);
}

function keyToInternalName_(k) {
  // Not used extensively; here for future mapping if needed
  return String(k || '').trim();
}

function toBool_(value, defaultVal) {
  if (typeof value === 'boolean') return value;
  if (typeof value === 'number') return value !== 0;
  const s = String(value == null ? '' : value).trim().toUpperCase();
  if (s === '') return !!defaultVal;
  if (['YES','Y','TRUE','T','ON','1'].includes(s)) return true;
  if (['NO','N','FALSE','F','OFF','0'].includes(s)) return false;
  return !!defaultVal;
}

function combineCc_(cfg) {
  return [cfg.managerEmail || '', cfg.ccExtra || ''].filter(Boolean).join(',');
}

function sanitize_(s) {
  return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');
}

function escapeHtml_(s) {
  return String(s)
    .replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')
    .replaceAll('"','&quot;').replaceAll("'",'&#39;');
}

function sanitizeKeepBasicHtml_(s) { return String(s); }

function safeAlert_(msg) {
  try { SpreadsheetApp.getUi().alert(msg); } catch (_) { Logger.log(msg); }
}

function showHtmlOrDraft_(html, title) {
  const output = HtmlService.createHtmlOutput(html).setWidth(900).setHeight(750);
  try {
    // Sanity: ensure we are in a spreadsheet-bound UI context
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) throw new Error('No active spreadsheet container.');
    SpreadsheetApp.getUi().showModalDialog(output, title);
  } catch (e) {
    const msg = String(e && e.message || e);
    // Only fall back to Gmail draft for known "no UI" cases
    const isHeadless =
      msg.includes('Cannot call SpreadsheetApp.getUi') ||
      msg.includes('No active spreadsheet') ||
      msg.includes('No active spreadsheet container') ||
      msg.includes('There is no active container');

    if (isHeadless) {
      const dest = Session.getActiveUser().getEmail();
      GmailApp.createDraft(dest, `PREVIEW – ${title}`, '', { htmlBody: html });
      Logger.log(`No UI context. Preview written to Gmail draft for ${dest}`);
      return;
    }

    // Otherwise surface the true error (use toast + rethrow for visibility)
    try { SpreadsheetApp.getActive().toast('Preview failed: ' + msg); } catch (_) {}
    throw e;
  }
}


