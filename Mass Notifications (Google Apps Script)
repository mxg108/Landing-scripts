/****************************************************
 * MASS NOTIFICATIONS — v2.6.5 (2025-11-08)
 * Author: Landing (Max Perez)
 *
 * WHAT'S NEW IN v2.6.5
 * - signature_html is now Member Support's by default
 * - genericDisclaimer() is now formatted within a box using Landing colors, also includes Property name.
 * - "Full Reset" now clears global attachments and restores subject and closing to default values.
 * - DryRunPreview now has guardrails that won't break the preview if phone links are attached.
 * - Manager name automatically appended to the closing from "manager_email" key.
 * 
 * WHAT'S NEW IN v2.6.0 (Attachments)
 * - Attachments in INDIVIDUAL send:
 *    • Per-row + per-config file IDs are merged and attached.
 *    • Google files (Docs/Slides/Sheets) auto-export to PDF at send (requires Advanced Drive service).
 * - Attachments in BCC send:
 *    • Config-level attachments only (one set for the whole batch).
 * - Dry-Run improvements:
 *    • “Preview first N” now lists attachment NAMES per row (no download).
 *    • “Create drafts (first N)” includes attachments.
 *    • “Test send to me (Individual)” includes attachments.
 * - Preflight:
 *    • “Validate attachments” checks existence & total size, per row, before sending.
 *
 * REQUIRED SCHEMA (Recipients: default "Mass_Notifications")
 *   A Email (required)
 *   B Member Name (optional; used for {{first_name}})
 *   C Unit (optional; INDIVIDUAL only if include_unit_line = YES)
 *   D Status (eligible if blank/PENDING/READY; DRAFT/SENT skipped)
 *   E Last Sent (timestamp)
 *   F Notes (free)
 *   G Attachment File IDs (optional; comma-separated Drive file IDs)
 *
 * NEW/UPDATED CONFIG KEYS (Config: key/value)
 *   attachment_file_ids          -> global attachments (comma-separated Drive file IDs)
 *   (existing) body_full_html    -> optional full-body override (tokens apply; signature appended)
 *   (existing) dry_run_limit     -> preview/draft count cap (default 10)
 *   (existing) batch_size        -> BCC batch size (default 90)
 *   (existing) max_per_run       -> INDIVIDUAL safety cap (default 500)
 *
 * ATTACHMENT RULES & LIMITS
 * - Gmail hard limit ~25 MB; we enforce ~20 MB per message (configurable in getBlobsForIds_()).
 * - Row attachments = Config attachments + Row attachments (INDIVIDUAL only).
 * - BCC uses Config attachments only (row-specific files would require separate batches).
 * - If any file missing/unreadable -> row marked REVIEW with note "ATTACH_NOT_FOUND id=…"
 * - If total size > limit -> row marked REVIEW with note "ATTACH_TOO_LARGE total=…"
 *
 * DRY-RUN & PREVIEW BEHAVIOR
 * - Preview first N (Individual): shows To/CC/Subject/Body + attachment names (no downloads).
 * - Create drafts (Individual): creates Gmail drafts with actual attachments; marks rows DRAFT.
 * - Test send to me (Individual): sends to test_email (or your account) with attachments.
 * - BCC previews remain config-only for attachments.
 *
 * SAFETY & AUDIT
 * - Validation: config warnings are non-blocking; operator confirm required to proceed.
 * - Run Log: captures VERSION, actor, counts, and per-row before/after states.
 * - Undo: reverts sheet state (Status/Last Sent); emails already sent cannot be recalled.
 *
 * QUICK START (v2.6)
 * 1) Mass Notify → Config/Tools → Ensure Config UI
 * 2) In Config set property_name, event_name, window_start/end, send_mode, (optional) attachment_file_ids
 * 3) Paste recipients (A..C), Optionally add per-row G Attachment File IDs, set Status = PENDING/READY
 * 4) Config/Tools → Validate attachments
 * 5) Dry Run → Preview / Drafts / Test
 * 6) Send (uses Config → send_mode)
 *
 * NOTES
 * - To attach Google files as PDFs, enable Advanced Drive (Services → + → Drive API).
 * - Tokens supported in templates (subject/body/body_full_html): {{first_name}} {{member_name}} {{member_email}} {{unit}} {{property_name}} {{event_name}} {{date_range}} {{today}} {{manager_email}}
 * - Use {{token | fallback}} for safe defaults (e.g., {{first_name | Resident}})
 *
 * SEMVER
 * - v2.6.0 = minor feature release (attachments), backward-compatible with v2.5.x schema
 * - Next minor: templates/scheduling
 * - Major (v3.x): breaking schema changes (e.g., adding Phone column for SMS)
 ****************************************************/

// ---------- GLOBAL CONSTANTS ----------
const VERSION = 'v2.6.5';
const CONFIG_SHEET = 'Config';
const DEFAULT_RECIPIENTS_SHEET = 'Mass_Notification';
const RUN_LOG_SHEET = 'Run_Log';

// Recipients sheet columns (1-based)
const COL = { EMAIL:1, NAME:2, UNIT:3, STATUS:4, LAST_SENT:5, NOTES:6, ATTACH_IDS:7 };
const COL_MAX = 7;


// ---------- MENU ----------
function validateAttachments_() {
  const cfg = loadConfig_();
  const sh  = getRecipientsSheet_(cfg);
  const last = sh.getLastRow();
  const cfgIds = parseIdList_(cfg.attachmentFileIds);
  const maxBytes = 20 * 1024 * 1024;

  let ok = 0, review = 0, rowsChecked = 0;
  const issues = [];

  // Validate config-level files first
  try {
    if (cfgIds.length) getBlobsForIds_(cfgIds, { exportGoogleToPdf: true, maxBytes });
  } catch (e) {
    issues.push(`Config attachments failed: ${e.message}`);
  }

  if (last >= 2) {
    const data = sh.getRange(2,1,last-1, COL_MAX).getValues();
    data.forEach((r, i) => {
      const status = String(r[COL.STATUS-1]||'').toUpperCase();
      if (status && status !== '' && status !== 'PENDING' && status !== 'READY') return;

      const rowIds = parseIdList_(r[COL.ATTACH_IDS-1]);
      const allIds = [...cfgIds, ...rowIds];
      if (!allIds.length) { ok++; rowsChecked++; return; }

      try {
        getBlobsForIds_(allIds, { exportGoogleToPdf: true, maxBytes });
        ok++;
      } catch (e) {
        review++;
        issues.push(`Row ${i+2}: ${e.message}`);
      }
      rowsChecked++;
    });
  }

  const html = `
    <div style="font-family:Arial,Helvetica,sans-serif;padding:10px;">
      <h2 style="margin:0 0 8px;">Attachments Validation</h2>
      <div><strong>Rows checked:</strong> ${rowsChecked}</div>
      <div><strong>OK:</strong> ${ok}</div>
      <div><strong>Need review:</strong> ${review}</div>
      ${issues.length ? '<hr><div><strong>Issues:</strong><br>' + issues.map(x=>escapeHtml_(x)).join('<br>') + '</div>' : ''}
    </div>`;
  showHtmlOrDraft_(html, 'Attachments Validation');
}

